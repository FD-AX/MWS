# OpenAI-совместимый endpoint: облако или локальный (LM Studio/vLLM/OpenRouter).
# Все три переменные обязательны для LLM-проходов; без них работает только --no-llm.
TZR_BASE_URL=http://localhost:1234/v1
TZR_API_KEY=lm-studio
TZR_MODEL=qwen2.5-32b-instruct

# Язык документов на ревью: ru | en (гард цитат; иной код = гард выключен)
TZR_DOC_LANG=ru
