# Бэкенд модели для воркера. Основная и единственная модель проекта — self-hosted gpt-oss-120b (vLLM);
# pod = любой OpenAI-совместимый эндпоинт (vLLM на RunPod / в контуре МТС / профиль gpu этого compose).
TZR_BACKEND=pod
TZR_BASE_URL=https://<pod_id>-8000.proxy.runpod.net/v1
TZR_API_KEY=tzr-local-token
TZR_MODEL=gpt-oss-120b
# Reasoning-модель: бюджет генерации и уровень размышлений (EXP-15)
TZR_MAX_TOKENS=4096
TZR_REASONING_EFFORT=medium
# Потоковый транспорт: прокси (Cloudflare/RunPod) режет запросы без байтов >100 с (EXP-19)
TZR_STREAM=1
# Зонд неоднозначности для reasoning-моделей — Монте-Карло, не логиты (EXP-19)
TZR_PROBE_MODE=sample

# ── Конфигурация конвейера (PROTOCOL.md, матрица m4). Прод-кандидат 120b: v2x =
#    конвейер + граф + общие слоты; энтропия выключена до EXP-21 (взрывы шума), зонд — по решению EXP-22.
TZR_RUBRIC_EXTRA=1     # общие слоты rubric_extra.yaml (ORD/REF-02/HIS/TZ) — v2x/v2f
TZR_LOGPROBS=0         # 1 = зонд неоднозначности (v2s/v2f)
TZR_ENTROPY=0          # 1 = semantic entropy (v2e/v2f)
TZR_THRESHOLD=4.0      # порог критика

# Справочный потолок (не в проде; новых прогонов нет с 05.09) — TZR_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_CHEAP=gpt-5.4-mini
OPENAI_PROBE_MODE=sample

# Профиль gpu (vLLM локально, та же модель)
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_LEN=32768
# Профиль eval
BENCH_VARIANTS=v1g,v2g
