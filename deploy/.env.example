# Бэкенд модели для воркера: pod (любой OpenAI-совместимый: vLLM, ollama, RunPod, контур МТС) или openai
TZR_BACKEND=pod
TZR_BASE_URL=https://<pod_id>-11434.proxy.runpod.net/v1
TZR_API_KEY=tzr-local-token
TZR_MODEL=gpt-oss:120b
# Числовые зонды: 1 — если бэкенд отдаёт logprobs (vLLM, gpt-4.1); ollama — 0
TZR_LOGPROBS=0
TZR_ENTROPY=0
TZR_THRESHOLD=4.0

# Референс-облако (TZR_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_CHEAP=gpt-5.4-mini

# Профиль gpu (vLLM локально)
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_LEN=32768
# Профиль eval
BENCH_VARIANTS=v1g,v2g
